# ============================================================
# 📁 .gitignore - Taller de Pruebas de Software (SENA)
# Protege credenciales, dependencias y reportes generados
# ============================================================

# 1. Dependencias
node_modules/
*/node_modules/

# 2. Variables de entorno y claves secretas (🚨 Evita penalización -20%)
.env
.env.local
.env.*.local
*.env
api/.env
api/.env.local
web/.env
web/.env.local

# 3. Reportes de Cobertura (se entregan en evidencias/ según la guía)
coverage/
*/coverage/
*.lcov

# 4. Reportes y resultados de Playwright E2E
playwright-report/
*/playwright-report/
test-results/
*/test-results/
.playwright/

# 5. Archivos y reportes automáticos de TestSprite
testsprite_tests/
*/testsprite_tests/

# 6. Compilación y builds
dist/
dist-ssr/
*.local

# 7. Logs y archivos temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tunel.log

# 8. Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
