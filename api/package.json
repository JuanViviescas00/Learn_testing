{
  "name": "app-usuarios-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST con autenticación JWT y CRUD de usuarios (MVC + MongoDB)",
  "scripts": {
    "dev": "node --watch app.js",
    "start": "node app.js",
    "seed": "node database/seed.js",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^4.1.12",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
